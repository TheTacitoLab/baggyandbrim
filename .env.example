# Baggy & Brim environment variables.
# Copy to .env.local for local development. Never commit .env.local.
# See build spec Section 31.

# Web3Forms access key. Server only. NEVER prefix with NEXT_PUBLIC_.
# The enquiry form does not deliver without this. TODO-07: supplied by client.
WEB3FORMS_ACCESS_KEY=

# Canonical production origin. Used for metadataBase, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://baggyandbrim.com

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Analytics disabled entirely when absent.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token. Meta tag omitted when absent.
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional recipient override passed to Web3Forms if the account default is wrong.
ENQUIRY_NOTIFICATION_EMAIL=

# 'true' enables the cookie-consent banner. Left disabled until the legal position
# is confirmed (TODO-16).
NEXT_PUBLIC_ENABLE_CONSENT_BANNER=
